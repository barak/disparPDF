From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Wed, 7 Oct 2026 23:14:44 +0100
Subject: install: manual pages from help2man, desktop file, icon, docs

The manual pages disparPDF.1 and disparPDFc.1 are now generated by
help2man from --help and --version plus doc_man/*.h2m, replacing the
ConfrontaPDF pages from 2015, which no longer matched the options.
Without help2man, or when cross compiling, the generated copies kept in
doc_man are installed instead; CMake warns if they are out of date, and
the update-manpages target refreshes them.

On Linux and the BSDs, also install disparPDF.desktop and the icon, so
that the program appears in the application menus, and set the
application's desktop file name, by which Wayland desktops find the
icon.  Besides images/icon.png, add a scalable images/icon.svg, drawn
in 2020 for Debian's diffpdf package.  Install README.md and CHANGES,
and use GNUInstallDirs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DFo7ywK1YasqiQ8A3v7kVX
---
 CMakeLists.txt          |  60 +++++++++++-
 README.ja.md            |   3 +-
 README.md               |  11 ++-
 disparPDF.desktop       |  11 +++
 doc_man/confrontapdf.1  |  99 -------------------
 doc_man/confrontapdfc.1 |  87 -----------------
 doc_man/disparPDF.1     | 176 +++++++++++++++++++++++++++++++++
 doc_man/disparPDF.h2m   |  63 ++++++++++++
 doc_man/disparPDFc.1    | 153 +++++++++++++++++++++++++++++
 doc_man/disparPDFc.h2m  |  52 ++++++++++
 images/icon.svg         | 252 ++++++++++++++++++++++++++++++++++++++++++++++++
 main.cpp                |   2 +
 12 files changed, 780 insertions(+), 189 deletions(-)
 create mode 100644 disparPDF.desktop
 delete mode 100644 doc_man/confrontapdf.1
 delete mode 100644 doc_man/confrontapdfc.1
 create mode 100644 doc_man/disparPDF.1
 create mode 100644 doc_man/disparPDF.h2m
 create mode 100644 doc_man/disparPDFc.1
 create mode 100644 doc_man/disparPDFc.h2m
 create mode 100644 images/icon.svg

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0454593..e9ae75f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -247,7 +247,65 @@ if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
     add_subdirectory(test)
 endif()
 
+# ---- Install ----
+include(GNUInstallDirs)
 install(TARGETS disparPDF disparPDFc
-    RUNTIME DESTINATION bin
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
     BUNDLE  DESTINATION .
 )
+install(FILES README.md CHANGES DESTINATION ${CMAKE_INSTALL_DOCDIR})
+
+# The desktop file and icon, for the menus of Linux and BSD desktops
+if(UNIX AND NOT APPLE)
+    install(FILES disparPDF.desktop
+            DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
+    install(FILES images/icon.png
+            DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/64x64/apps
+            RENAME disparPDF.png)
+    install(FILES images/icon.svg
+            DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps
+            RENAME disparPDF.svg)
+endif()
+
+# The manual pages are generated by help2man from the programs' --help
+# and --version (which need no display) plus doc_man/*.h2m.  That runs
+# the programs, so when cross compiling, or without help2man, the copies
+# of the generated pages kept in doc_man are installed instead.  After
+# changing the options or the .h2m files, refresh those copies with
+# "cmake --build build --target update-manpages" and commit them.
+find_program(HELP2MAN_EXECUTABLE help2man)
+set(MANPAGES)
+set(MANPAGE_COPIES)
+foreach(_prog disparPDF disparPDFc)
+    set(_cached ${CMAKE_CURRENT_SOURCE_DIR}/doc_man/${_prog}.1)
+    if(HELP2MAN_EXECUTABLE AND NOT CMAKE_CROSSCOMPILING)
+        set(_page ${CMAKE_CURRENT_BINARY_DIR}/${_prog}.1)
+        set(_h2m ${CMAKE_CURRENT_SOURCE_DIR}/doc_man/${_prog}.h2m)
+        add_custom_command(
+            OUTPUT ${_page}
+            COMMAND ${HELP2MAN_EXECUTABLE} --no-info --include=${_h2m}
+                    --output=${_page} $<TARGET_FILE:${_prog}>
+            DEPENDS ${_prog} ${_h2m}
+            COMMENT "Generating the ${_prog} manual page with help2man"
+            VERBATIM)
+        list(APPEND MANPAGE_COPIES
+             COMMAND ${CMAKE_COMMAND} -E copy ${_page} ${_cached})
+    else()
+        set(_page ${_cached})
+        file(STRINGS ${_page} _th REGEX "^\\.TH " LIMIT_COUNT 1)
+        if(NOT _th MATCHES "\"${_prog} ${PROJECT_VERSION}\"")
+            message(WARNING "The cached manual page doc_man/${_prog}.1 is "
+                "not for version ${PROJECT_VERSION}; refresh it with the "
+                "update-manpages target in a native build with help2man.")
+        endif()
+    endif()
+    list(APPEND MANPAGES ${_page})
+endforeach()
+if(MANPAGE_COPIES)
+    add_custom_target(manpages ALL DEPENDS ${MANPAGES})
+    add_custom_target(update-manpages ${MANPAGE_COPIES}
+        DEPENDS ${MANPAGES}
+        COMMENT "Copying the generated manual pages into doc_man"
+        VERBATIM)
+endif()
+install(FILES ${MANPAGES} DESTINATION ${CMAKE_INSTALL_MANDIR}/man1)
