diff --git a/completions/_disparPDF b/completions/_disparPDF
new file mode 100644
index 0000000..f10988e
--- /dev/null
+++ b/completions/_disparPDF
@@ -0,0 +1,34 @@
+#compdef disparPDF disparPDFc
+# zsh completion for disparPDF and disparPDFc
+
+local pdf='_files -g "*.(#i)pdf(-.)"'
+local file=$pdf
+# Files must be named *.pdf unless --any-extension is given
+(( ${words[(I)--any-extension]} )) && file=_files
+
+local -a batch
+# disparPDFc is always in batch mode
+[[ $service == disparPDFc ]] ||
+  batch=('(-b --batch)'{-b,--batch}'[compare without a window]')
+
+_arguments -s -S \
+  '(-a --appearance -c --characters -w --words)'{-a,--appearance}'[compare the appearance of the pages]' \
+  '(-a --appearance -c --characters -w --words)'{-c,--characters}'[compare the text character by character]' \
+  '(-a --appearance -c --characters -w --words)'{-w,--words}'[compare the text word by word]' \
+  '--any-extension[accept files whose names do not end in .pdf]' \
+  '--language=[use the given translation language]:language:(cz de en fr)' \
+  '--debug=[write the text fed to the sequence matcher into temporary files]:level:((2\:"the text" 3\:"the text, with coordinates"))' \
+  $batch \
+  '--outType=[what to print in batch mode]:output:((0\:"only the result code" 1\:"the result code and a description"))' \
+  '--pages=[compare N pages (default all)]:number of pages' \
+  '--startPage1=[start at page N of FILE1]:page number' \
+  '--startPage2=[start at page N of FILE2]:page number' \
+  '--pdfdiff=[save the pages that differ, highlighted, to FILE]:PDF file to save the differences to:'"$pdf" \
+  '--xmlResult=[write the result, in XML, to FILE]:XML file:_files -g "*.(#i)xml(-.)"' \
+  '--key=[record KEY in the XML result]:key' \
+  '--settings=[read settings from FILE, in INI format]:settings file:_files' \
+  '--compareFonts[also compare the fonts the files use]' \
+  '(- *)'{-h,--help}'[display help and exit]' \
+  '(- *)--version[output version information and exit]' \
+  "1:first PDF file:$file" \
+  "2:second PDF file:$file"
diff --git a/completions/disparPDF.bash b/completions/disparPDF.bash
new file mode 100644
index 0000000..5346bd9
--- /dev/null
+++ b/completions/disparPDF.bash
@@ -0,0 +1,77 @@
+# bash completion for disparPDF and disparPDFc            -*- shell-script -*-
+# Installed as .../bash-completion/completions/disparPDF, with a symbolic
+# link to it named disparPDFc
+
+_disparPDF()
+{
+    local cur prev words cword
+    _init_completion -n = || return
+
+    # Files must be named *.pdf unless --any-extension is given, and
+    # after "--" everything is a file
+    local i pattern='@(pdf|PDF)' options=true
+    for ((i = 1; i < cword; i++)); do
+        case ${words[i]} in
+            --any-extension) pattern= ;;
+            --) options=false ;;
+        esac
+    done
+
+    if $options; then
+        case $cur in
+            --language=*)
+                COMPREPLY=($(compgen -W 'cz de en fr' -- "${cur#*=}"))
+                return
+                ;;
+            --debug=*)
+                COMPREPLY=($(compgen -W '2 3' -- "${cur#*=}"))
+                return
+                ;;
+            --outType=*)
+                COMPREPLY=($(compgen -W '0 1' -- "${cur#*=}"))
+                return
+                ;;
+            --pages=* | --startPage1=* | --startPage2=* | --key=*)
+                # A number, or for --key any text
+                return
+                ;;
+            --pdfdiff=*)
+                cur=${cur#*=}
+                _filedir '@(pdf|PDF)'
+                return
+                ;;
+            --xmlResult=*)
+                cur=${cur#*=}
+                _filedir xml
+                return
+                ;;
+            --settings=*)
+                cur=${cur#*=}
+                _filedir
+                return
+                ;;
+        esac
+
+        if [[ $cur == -* ]]; then
+            local opts='-a --appearance -c --characters -w --words
+                --any-extension --language= --debug=2 --debug=3
+                --outType=0 --outType=1 --pages= --startPage1= --startPage2=
+                --pdfdiff= --xmlResult= --key= --settings= --compareFonts
+                -h --help --version --'
+            # disparPDFc is always in batch mode
+            [[ ${words[0]##*/} == disparPDFc ]] || opts+=' -b --batch'
+            COMPREPLY=($(compgen -W "$opts" -- "$cur"))
+            [[ ${COMPREPLY-} == *= ]] && compopt -o nospace
+            return
+        fi
+    fi
+
+    if [[ $pattern ]]; then
+        _filedir "$pattern"
+    else
+        _filedir
+    fi
+} &&
+    complete -F _disparPDF disparPDF disparPDFc
+
+# ex: filetype=sh
