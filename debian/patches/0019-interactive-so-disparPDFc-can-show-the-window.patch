diff --git a/README.md b/README.md
index 06f1c88..661d403 100644
--- a/README.md
+++ b/README.md
@@ -213,9 +213,9 @@ disparPDFc -b --xmlResult=result.xml a.pdf b.pdf
 ```
 
 `disparPDFc` is not a separate program but a symbolic link to `disparPDF`
-(on Windows, a copy of it): run by that name, it is always in batch mode,
-so `-b` is optional, and it needs no display.  `disparPDF -b` does the
-same.
+(on Windows, a copy of it): run by that name, it is in batch mode, so
+`-b` is optional, and it needs no display.  `disparPDF -b` does the
+same, and `disparPDFc --interactive` shows the window, as `disparPDF` does.
 
 ## Settings
 
diff --git a/completions/_disparPDF b/completions/_disparPDF
index f10988e..9d0f250 100644
--- a/completions/_disparPDF
+++ b/completions/_disparPDF
@@ -7,9 +7,13 @@ local file=$pdf
 (( ${words[(I)--any-extension]} )) && file=_files
 
 local -a batch
-# disparPDFc is always in batch mode
-[[ $service == disparPDFc ]] ||
-  batch=('(-b --batch)'{-b,--batch}'[compare without a window]')
+# disparPDFc is in batch mode unless given --interactive
+if [[ $service == disparPDFc ]]; then
+  batch=('--interactive[show the window, as disparPDF does]')
+else
+  batch=('(-b --batch --interactive)'{-b,--batch}'[compare without a window]'
+         '(-b --batch --interactive)--interactive[show the window (the default)]')
+fi
 
 _arguments -s -S \
   '(-a --appearance -c --characters -w --words)'{-a,--appearance}'[compare the appearance of the pages]' \
